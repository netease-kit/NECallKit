<template>
  <text class="time">
    {{ callDuration }}
  </text>
</template>

<script setup lang="uts">
import { state } from '@/store/index.uts'

const callDuration = ref('00:00')
let timer: number | null = null

function formatTime(sec: number): string {
  const m = Math.floor(sec / 60).toString().padStart(2, '0')
  const s = (sec % 60).toString().padStart(2, '0')
  return `${m}:${s}`
}

function updateCallDuration(): void {
  if (state.callConnectedAt <= 0) {
    callDuration.value = '00:00'
    return
  }

  let seconds = Math.floor((Date.now() - state.callConnectedAt) / 1000)
  if (seconds < 0) {
    seconds = 0
  }
  callDuration.value = formatTime(seconds)
}

onMounted(() => {
  updateCallDuration()
  timer = setInterval(() => {
    updateCallDuration()
  }, 1000)
})

onUnmounted(() => {
  if (timer != null) {
    clearInterval(timer)
  }
})
</script>

<style scoped>
.time {
  font-size: 14px;
  color: #d5e0f2;
}
</style>
