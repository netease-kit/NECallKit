platform :ios, '15.0'

source 'https://github.com/CocoaPods/Specs.git'
target 'NLiteAVDemo' do
  use_frameworks!

  # 云信基础 SDK
  pod 'NERtcSDK', '5.9.10'
  pod 'NIMSDK_LITE', '10.9.76'

  #呼叫组件API组件
  pod 'NERtcCallKit', '4.8.5'

  #呼叫组件UI组件
  pod 'NERtcCallUIKit', '4.8.5'

  #如果需要查看呼叫组件UI组件源码请注释远端引用，打开下面本地引用
  #pod 'NERtcCallUIKit', :path => 'CallKit/NERtcCallUIKit/NERtcCallUIKit.podspec'

  pod 'NETranscodingKit', '1.0.3'

  # 三方依赖
  pod 'Masonry'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
